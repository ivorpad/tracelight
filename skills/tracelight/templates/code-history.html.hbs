<!doctype html>
<html lang="{{lang}}"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{title}}</title>
<style>
:root{color-scheme:dark;--bg:#151d21;--panel:#202d33;--edge:#33444b;--ink:#dce5e8;--dim:#829399;--green:#73c9a5;--gold:#ffc463}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.55 system-ui,sans-serif}header,main,footer{max-width:1540px;margin:auto;padding:24px 32px}header{padding-bottom:16px}.eyebrow{font-size:11px;letter-spacing:2px;color:var(--green);font-weight:650}h1{font-size:30px;font-weight:600;letter-spacing:-1px;margin:8px 0}p{margin:8px 0;color:#aebdc3}.chips{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0 0}.chip{font:11px/1.5 ui-monospace,monospace;color:#9fb2b9;background:#1b272c;border:1px solid var(--edge);border-radius:4px;padding:3px 8px;overflow-wrap:anywhere}.chip b{color:var(--dim);font-weight:500;text-transform:uppercase;letter-spacing:.5px;margin-right:5px}.chip.warn{color:#ffd79a;border-color:#7a5f2e;background:#2a2318}.summary{margin-top:18px;padding:13px 16px;border-left:3px solid var(--green);background:#1c2a2e;color:#d5e5e4}.toolbar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:0 0 18px}.toolbar input{flex:1;min-width:110px;accent-color:var(--gold)}button{font:inherit;color:var(--ink);background:#29383f;border:1px solid #465960;padding:7px 13px;border-radius:5px;cursor:pointer}button:hover{border-color:var(--gold)}button:disabled{opacity:.35;cursor:default}button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--gold);outline-offset:4px}.counter{font:12px ui-monospace,monospace;min-width:80px;color:var(--gold)}.panels{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.12fr);gap:18px}.panel{background:var(--panel);border:1px solid var(--edge);border-radius:7px;overflow:hidden}.panelbar{padding:10px 15px;border-bottom:1px solid var(--edge);font:11px ui-monospace,monospace;letter-spacing:1px;color:#9aabb2;display:flex;justify-content:space-between;gap:10px}.source{height:650px;overflow:auto;padding:16px 0;scroll-behavior:smooth}.line{display:flex;min-height:23px;white-space:pre;font:12px/23px ui-monospace,SFMono-Regular,Consolas,monospace;color:#8b9ca3;opacity:.42}.ln{flex:0 0 52px;text-align:right;padding-right:16px;user-select:none;color:#778a92}.code{padding-right:20px}.line.bright{color:#e0e9ed;opacity:1}.line.bright .ln::before{content:'▪';color:var(--green);margin-right:7px}.line.current .code{outline:1px solid var(--gold);outline-offset:1px}.line.current{background:#36403a;opacity:1}.history{height:650px;overflow:auto;padding:12px 18px;scroll-behavior:smooth}.entry{padding:20px 0 24px;border-bottom:1px solid var(--edge);opacity:.65}.entry.active{opacity:1}.stephead{display:flex;gap:12px;align-items:center}.number{font:15px ui-monospace,monospace;color:var(--gold);border:1px solid #607068;width:30px;height:30px;display:grid;place-items:center;border-radius:50%;flex-shrink:0}.tagline{display:flex;gap:9px;align-items:baseline;flex-wrap:wrap}.tag{color:var(--green);font-size:10px;letter-spacing:1px;text-transform:uppercase}.tag.live{color:#ffb0b0}.badge{font:11px ui-monospace,monospace;color:var(--gold);border:1px solid #5e5030;border-radius:3px;padding:0 5px}.title{font-size:16px;margin:2px 0 0}.choose{all:unset;cursor:pointer;display:block}.choose:hover .title{color:var(--gold)}.entry p{font-size:13px}.snippet{overflow:auto;padding:8px 0;margin:12px 0;background:#1b272c;border-radius:4px}.facts{font:11px ui-monospace,monospace;color:#9fb2b9;margin:10px 0}.io{margin:12px 0;font:12px/1.8 ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere}.io div{color:var(--gold)}.io .arrow{color:var(--green);margin-right:7px}.values{color:var(--gold);font:12px/1.85 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;margin:12px 0}.sub{margin:10px 0;font:11px/1.8 ui-monospace,monospace;color:#9fb2b9;overflow-wrap:anywhere}.sub b{color:var(--dim);font-weight:500;text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:3px}.chain{overflow-x:auto}.chain div{white-space:pre}.chain .nm{color:var(--gold)}.chain .via{color:var(--green)}.out{background:#151d21;border:1px solid var(--edge);border-radius:4px;padding:8px 10px;white-space:pre-wrap;color:#a6bac1;font:11px/1.6 ui-monospace,monospace;max-height:150px;overflow:auto}.note{border-left:2px solid #52656c;padding-left:10px;color:#a6bac1;font-size:12px}.verify{margin-top:12px;font:11px ui-monospace,monospace;color:#8fc8d5;overflow-wrap:anywhere;user-select:all}.verify b{color:var(--dim);font-weight:500;text-transform:uppercase;letter-spacing:.5px;margin-right:6px}.evidence{margin-top:12px;font-size:11px}a{color:#8fc8d5;text-underline-offset:3px}.evidence a{margin-right:12px;display:inline-block}.legend{display:flex;gap:20px;flex-wrap:wrap;margin-top:13px;color:#91a6ae;font-size:11px}.legend b{color:var(--gold)}footer{font-size:12px;color:var(--dim);padding-top:0}.scope{max-width:920px}.kbd{font-family:ui-monospace,monospace;color:#c6d6dc}.chip,.line,.values,.io,.sub,.facts,.out,.verify,.counter,.badge,.panelbar,.number{font-variant-ligatures:none;font-feature-settings:'liga' 0,'calt' 0}@media(max-width:850px){header,main,footer{padding:18px}.panels{grid-template-columns:1fr}.source{height:340px}.history{height:550px}h1{font-size:24px}.line{font-size:11px}.toolbar{gap:8px}}
</style>
<header>
  {{#if eyebrow}}<div class="eyebrow">{{eyebrow}}</div>{{/if}}
  {{#if heading}}<h1>{{heading}}</h1>{{/if}}
  {{#if subtitle}}<p>{{subtitle}}</p>{{/if}}
  <div class="chips">{{chip labels.run meta.file}}{{chip labels.mode meta.mode}}{{chip labels.sourceHash meta.sourceSha256}}{{chip labels.runJson meta.runSha256}}{{chip labels.python meta.python}}{{chip labels.exit meta.exitCode}}{{chip labels.steps meta.stepCount}}{{chip labels.pausedAt meta.paused}}{{chip labels.recorded meta.recordedAt}}{{#each meta.truncated}}<span class="chip warn"><b>{{@root.labels.leftOut}}</b> {{this}}</span>{{/each}}</div>
  {{#if summary}}<div class="summary">{{summary}}</div>{{/if}}
</header>
<main><nav class="toolbar" aria-label="{{labels.nav}}"><button id="prev" aria-label="{{labels.prev}}">{{labels.prev}}</button><input id="scrub" type="range" min="0" max="0" value="0" aria-label="{{labels.checkpoint}}"><button id="next" aria-label="{{labels.next}}">{{labels.next}}</button><span class="counter" id="counter" aria-live="polite"></span></nav><div class="panels"><section class="panel" aria-label="{{labels.source}}"><div class="panelbar"><span id="filename"></span><span>{{labels.sourceSide}}</span></div><div id="source" class="source"></div></section><section class="panel" aria-label="{{labels.history}}"><div class="panelbar"><span>{{labels.history}}</span><span>{{historyLabel}}</span></div><div id="history" class="history"></div></section></div><div class="legend"><span style="color:var(--green)">{{labels.relevant}}</span><span>{{labels.dim}}</span><span><b>□</b> {{labels.selected}}</span><span><span class="kbd">← →</span> {{labels.navigate}}</span></div></main>
<footer>
  {{#if scope}}<p class="scope">{{scope}}</p>{{/if}}
  <p class="scope">{{footer}}{{#if reportHref}} <a href="{{reportHref}}">{{reportLabel}}</a>.{{/if}}</p>
</footer>
<script id="data" type="application/json">{{{json this}}}</script>
<script>
'use strict';
const {files,steps,labels,highlight}=JSON.parse(document.getElementById('data').textContent);
const el=id=>document.getElementById(id);let current=0;
el('scrub').max=steps.length-1;
function node(tag,cls,text){const n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=text;return n;}
function code(file,n){const span=node('span','code');const tokens=highlight&&highlight.files[file]&&highlight.files[file][n-1];if(!tokens||!tokens.length){span.textContent=files[file][n-1]||' ';return span;}for(const [colour,text,style] of tokens){const piece=node('span','',text);piece.style.color=highlight.palette[colour]||highlight.fg;if(style&1)piece.style.fontStyle='italic';if(style&2)piece.style.fontWeight='650';if(style&4)piece.style.textDecoration='underline';span.append(piece);}return span;}
function line(file,n,step){const row=node('div','line'+(step.bright.includes(n)?' bright':'')+(n===step.focus?' current':''));row.dataset.line=n;row.append(node('span','ln',n),code(file,n));return row;}
function sub(label,rows,cls){const box=node('div','sub'+(cls?' '+cls:''));box.append(node('b','',label));for(const row of rows)box.append(typeof row==='string'?node('div','',row):row);return box;}
function chainRow(n){const row=node('div');row.append(node('span','via','  '.repeat(n.depth)+(n.via==='root'?'●':n.via==='calls'?'↳':'←')+' '),node('span','nm',n.name),document.createTextNode(' = '+n.text+(n.location?'   '+n.location:'')+(n.step===null?'':'  #'+n.step)));return row;}
steps.forEach((s,i)=>{
  const card=node('article','entry');card.id='step-'+i;
  const btn=node('button','choose');btn.setAttribute('aria-label',labels.checkpoint+' '+(i+1)+': '+s.title);btn.onclick=()=>select(i);
  const head=node('div','stephead');const cell=node('div');const tagline=node('div','tagline');
  tagline.append(node('span','tag'+(s.kind==='live pause'?' live':''),s.tag));
  if(s.step!==null)tagline.append(node('span','badge','#'+s.step));
  if(s.reason)tagline.append(node('span','badge',s.reason));
  cell.append(tagline,node('h2','title',s.title));head.append(node('span','number',i+1),cell);btn.append(head);
  card.append(btn,node('p','',s.text));
  const snippet=node('div','snippet');for(let n=Math.max(s.start,s.focus-2);n<=Math.min(s.end,s.focus+2);n++)snippet.append(line(s.file,n,s));
  card.append(snippet);
  const facts=[s.hits===null?'':s.hits+' '+(s.hits===1?labels.hit:labels.hits),s.arm||'',s.exception||'',s.http||''].filter(Boolean);
  if(facts.length)card.append(node('div','facts',facts.join('  ·  ')));
  if(s.call){const io=node('div','io');for(const v of s.call.in){const d=node('div');d.append(node('span','arrow',labels.in),document.createTextNode(v));io.append(d);}if(s.call.out){const d=node('div');d.append(node('span','arrow',labels.out),document.createTextNode(s.call.out));io.append(d);}card.append(io);}
  if(s.values)card.append(node('pre','values',s.values));
  if(s.reads.length)card.append(sub(labels.reads,s.reads));
  if(s.chain.length)card.append(sub(labels.chain,s.chain.map(chainRow),'chain'));
  if(s.output)card.append(sub(labels.output,[node('pre','out',s.output)]));
  if(s.gloss)card.append(node('div','facts',s.gloss));
  if(s.note)card.append(node('div','note',s.note));
  const verify=node('div','verify');verify.append(node('b','',labels.verify),document.createTextNode(s.verify));card.append(verify);
  const links=node('div','evidence');for(const path of s.evidence){const a=node('a','',path.split('/').pop());a.href=path;links.append(a);}card.append(links);
  el('history').append(card);
});
function select(i){current=Math.max(0,Math.min(steps.length-1,i));const s=steps[current];el('filename').textContent=s.file+' : '+s.focus+(s.step===null?'':'   #'+s.step);el('source').replaceChildren();for(let n=s.start;n<=s.end;n++)el('source').append(line(s.file,n,s));el('scrub').value=current;el('counter').textContent=(current+1)+' / '+steps.length;el('prev').disabled=current===0;el('next').disabled=current===steps.length-1;document.querySelectorAll('.entry').forEach((c,j)=>c.classList.toggle('active',j===current));const target=el('step-'+current);el('history').scrollTo({top:target.offsetTop-el('history').offsetTop-12,behavior:'smooth'});const active=el('source').querySelector('.current');if(active)el('source').scrollTop=Math.max(0,active.offsetTop-el('source').offsetTop-180);}
el('prev').onclick=()=>select(current-1);el('next').onclick=()=>select(current+1);el('scrub').oninput=e=>select(Number(e.target.value));document.addEventListener('keydown',e=>{if(e.target.tagName==='INPUT')return;if(e.key==='ArrowRight'){e.preventDefault();select(current+1);}if(e.key==='ArrowLeft'){e.preventDefault();select(current-1);}});select(0);
</script></html>
